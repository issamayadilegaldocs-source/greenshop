# Environment template — copy to .env and fill in.

# --- Supabase (public) ---
# Project Settings -> API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API keys -> publishable key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Same two values for the browser bundle (Vite only exposes prefixed vars).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional compatibility with Next.js-style names; envPrefix exposes them in Vite.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Supabase (server-only; never prefix with VITE_/NEXT_PUBLIC_) ---
# Project Settings -> API keys -> secret key. Required only for server code that
# bypasses RLS (none yet).
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI credentials (for npm run db:push / db:types / db:diff) ---
SUPABASE_PROJECT_ID=<project-ref>
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Database password (Project Settings -> Database)
SUPABASE_DB_PASSWORD=

# --- AI product description writer & social copy (server-only, optional) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# --- AI generative lifestyle video (server-only, optional — Kling 2.1 MP4) ---
# Set either FAL_KEY (fal.ai) or REPLICATE_API_TOKEN (Replicate)
FAL_KEY=
REPLICATE_API_TOKEN=
